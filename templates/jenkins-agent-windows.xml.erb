<service>
  <id><%= @service_name %></id>
  <name><%= @service_name %></name>
  <description>ROS build farm jenkins agent</description>
  <executable><%= @java_exe %></executable>
  <arguments><![CDATA[<%= @java_args %> -jar "<%= @jarfile %>" -url <%= @jenkins_url %> -username <%= @username %> -passwordFile "<%= @password_file %>" -name <%= @name %> -description "<%= @description %>" -mode exclusive -executors <%= @executors %> -fsroot "<%= @fsroot %>" -labels "<%= @labels.join(' ') %>"]]></arguments>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <logpath><%= @logdir %></logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
