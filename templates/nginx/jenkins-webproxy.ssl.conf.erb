# Catch-all server block for any unrecognized or malicious domains
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444; # Closes the connection immediately without redirecting
}

# HTTP server is used just for ACME challenge and allowing build status icon
# links that are already in the wild to be accepted. Otherwise redirect to
# HTTPS
server {
	listen 80;
	server_name <%= @server_name %>;

	location / {
		return 301 https://<%=@server_name%>$request_uri;
	}

	# Allow ACME challenge to access the webroot directly.
	location '/.well-known/acme-challenge' {
		default_type "text/plain";
		root /var/www/html;
		allow all;
	}

	location '/buildStatus/icon' {
		proxy_set_header Host $host:$server_port;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_redirect http:// https://;
		proxy_buffering off;
		proxy_pass http://jenkins;
	}
}

# Catch-all for HTTPS traffic to unrecognized domains or raw IPs
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    # Drop the connection immediately during the TLS handshake 
    # without serving a mismatched certificate
    ssl_reject_handshake on;
}

# HTTPS server for proxying most Jenkins requests.
server {
	listen 443 ssl;
	server_name <%= @server_name %>;

	ssl_certificate <%= @cert_path %>;
	ssl_certificate_key <%= @key_path %>;
	  # Pass through jenkins headers nginx may consider invalid.
  	ignore_invalid_headers off;
    access_log /var/log/nginx/access.log;  

<% if hardening -%>
	access_log /var/log/nginx/bot_denied.log combined if=$stale_ua_pool;
<% end -%>

	# Allow ACME challenge to access the webroot directly.
	location '/.well-known/acme-challenge' {
		default_type "text/plain";
		root /var/www/html;
		allow all;
	}
	# Block potentially abuseable plugin test url.
	location '/descriptorByName/jenkins.plugins.publish_over_ssh.BapSshHostConfiguration' {
		root /dev/null;
		deny all;
	} 
<% if hardening -%>

	if ($blackhole_client) {
		return 444;
	}

	if ($is_headless_bot) {
        	return 403 "Forbidden";
    	}

	if ($stale_ua_pool) {
	 	return 403;
	}
<% end -%>


    client_body_timeout 60s;
    client_header_timeout 60s;
    keepalive_timeout 70s;

  # Mitigate ghprb SECURITY-2789 (CVE-2023-24434/-24435/-24436) — no upstream fix.
  # Blocks the credential-enumeration + connection-test form-validation endpoints.
  # see https://github.com/osrf/chef-osrf/issues/367
  location ~* "/descriptorByName/org\.jenkinsci\.plugins\.ghprb\." {
      return 403;
      access_log /var/log/nginx/ghprb_blocked.log;
  }
  # Cache static/adjuncts content aggressively to lessen 
   location ~* ^/(static|adjuncts)/ {
      proxy_set_header Host $host:$server_port;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_redirect http:// https://;
      proxy_cache jenkins_static;
      proxy_cache_valid 200 30d;
      proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
      add_header X-Cache-Status $upstream_cache_status;
      proxy_pass http://jenkins;
  }
<% if node['jenkins']['block_api_endpoints'] -%>
  
# API endpoints help bots identify how to query the buildfarm
  # There is no usual usage of them by the dev team so we should disable them
  location ~* /api/(xml|json|python|schema)(/|$) {
      return 503;
  }
<% end -%>

# Configure endpoints that are passed to Anubis
# If you need an endpoint to not be challenged by Anubis put it above this 
# since nginx evaluates sequentially it will otherwise be overwritten by anubis
<% if (node['jenkins']['anubis']) %>
 

location ^~ /.within.website/x/cmd/anubis/api/pass-challenge {
    limit_req zone=anubis_submit;
   
    proxy_set_header Host $host:$server_port;
    proxy_set_header X-Real-Ip $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Original-URI ""; # GHSA-6wcg-mqvh-fcvg mitigation 

    proxy_redirect http:// https://;
    proxy_buffering off; 
    proxy_pass http://anubis;

}
   # Serve Anubis images
    location ^~ /.within.website/ {
    proxy_set_header Host $host:$server_port;
    proxy_set_header X-Real-Ip $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Original-URI ""; # GHSA-6wcg-mqvh-fcvg mitigation 
    
    proxy_redirect http:// https://;
    proxy_buffering off;
    proxy_pass http://anubis;
  }

  # Anubis proxied endpoints
  location ~* /securityRealm(/|$)  {
    proxy_set_header Host $host:$server_port;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Original-URI ""; # GHSA-6wcg-mqvh-fcvg mitigation 

    proxy_redirect http:// https://;
    proxy_buffering off;
    proxy_pass http://anubis;
  }  
  location ~* /testReport(/|$)  {
    proxy_set_header Host $host:$server_port;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Original-URI ""; # GHSA-6wcg-mqvh-fcvg mitigation 

    proxy_redirect http:// https://;
    proxy_buffering off;
    proxy_pass http://anubis;
  }

  # Allow HTTP Basic auth to bypass Anubis for plain-text build logs
  # (Jenkins returns 401 for invalid Basic credentials without falling back to anonymous).
  location ~* /consoleText(/|$) {
    proxy_set_header Host $host:$server_port;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Original-URI ""; # GHSA-6wcg-mqvh-fcvg mitigation

    proxy_redirect http:// https://;
    proxy_buffering off;
    proxy_pass http://$anubis_or_jenkins;
  }

  # Build console output and the progressive log endpoints the console page
  # polls while a build is running.
  location ~* /(console(Full)?|logText/progressive(Text|Html))(/|$) {
    proxy_set_header Host $host:$server_port;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Original-URI ""; # GHSA-6wcg-mqvh-fcvg mitigation 

    proxy_redirect http:// https://;
    proxy_buffering off;
    proxy_pass http://anubis;
  }
  location ~* /(timings|changes|polling)(/|$) {
    proxy_set_header Host $host:$server_port;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Original-URI ""; # GHSA-6wcg-mqvh-fcvg mitigation 

    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect http:// https://;
    proxy_buffering off;
    proxy_pass http://anubis;
  }
<% end -%>


  	location / {
		if ($arg_depth ~* "^(?!0$).+") {
			return 444;
		}
    sendfile off;
    client_max_body_size 10m;
    client_body_buffer_size 128k;
    proxy_set_header Host $host:$server_port;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect http:// https://;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_connect_timeout 120s;
    proxy_send_timeout 120s;
    proxy_read_timeout 180s;
    proxy_pass http://jenkins;
  }

}

